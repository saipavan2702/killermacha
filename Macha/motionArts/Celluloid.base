filters:
  and:
    - or:
        - file.inFolder("Macha/motionArts/Items")
        - file.inFolder("Macha/motionArts/Library")
    - or:
        - media_type == "movie"
        - media_type == "series"
        - media_type == "anime"
        - media_type == "anime-movie"
        - media_type == "game"
properties:
  title:
    displayName: Title
  file.name:
    displayName: File
  poster:
    displayName: Cover
  media_type:
    displayName: Type
  industry:
    displayName: Industry
  watched:
    displayName: Watched
  watched_date:
    displayName: Watched date
  genres:
    displayName: Genres
  year:
    displayName: Year
  directors:
    displayName: Directors
  cast:
    displayName: Cast
  tags:
    displayName: Tags
  status:
    displayName: Status
  rating:
    displayName: Your rating (0–5)
  favorite:
    displayName: Favorite
  episode_current:
    displayName: Episodes watched
  episode_total:
    displayName: Total episodes
  hours_played:
    displayName: Hours played
  started_date:
    displayName: Started
  completed_date:
    displayName: Completed
  platforms:
    displayName: Platforms
  developers:
    displayName: Developers
  publishers:
    displayName: Publishers
  studios:
    displayName: Studios
  metadata_provider:
    displayName: Provider
  source_url:
    displayName: Source
views:
  - type: cards
    name: Movies
    filters:
      and:
        - media_type == "movie"
    order:
      - title
    sort:
      - property: file.name
        direction: ASC
    limit: 300
    image: poster
    imageProperty: poster
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 260
  - type: cards
    name: Series
    filters:
      and:
        - media_type == "series"
    order:
      - title
    limit: 100
    image: poster
    imageProperty: poster
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 260
  - type: cards
    name: Anime
    filters:
      and:
        - media_type == "anime"
    order:
      - title
    limit: 100
    image: poster
    imageProperty: poster
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 260
  - type: cards
    name: Anime Movies
    filters:
      and:
        - media_type == "anime-movie"
    order:
      - title
    limit: 100
    image: poster
    imageProperty: poster
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 260
  - type: cards
    name: Games
    filters:
      and:
        - media_type == "game"
    order:
      - title
    image: poster
    imageProperty: poster
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 260
  - type: cards
    name: Watchlist
    filters:
      and:
        - watched == false
    order:
      - title
    limit: 400
    image: poster
    imageProperty: poster
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 260
  - type: cards
    name: Watched
    filters:
      and:
        - watched == true
    order:
      - title
    limit: 400
    image: poster
    imageProperty: poster
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 260
  - type: cards
    name: Active
    filters:
      and:
        - status == "active"
    order:
      - title
    image: poster
    imageProperty: poster
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 260
  - type: cards
    name: Favorites
    filters:
      and:
        - favorite == true
    order:
      - title
    image: poster
    imageProperty: poster
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 260
  - type: table
    name: Manage
    order:
      - title
      - media_type
      - status
      - rating
      - favorite
      - watched
      - watched_date
      - season_current
      - season_total
      - episode_current
      - episode_total
      - hours_played
      - started_date
      - completed_date
      - year
      - genres
      - industry
      - directors
      - cast
      - poster
